DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
CHROMA_DB_PATH=./chroma_db
MODEL_CACHE_PATH=./models
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=4
VECTOR_TOP_K=12
BM25_TOP_K=12
RERANKER_CANDIDATE_K=20
RERANKER_SCORE_THRESHOLD=0.2
VECTOR_WEIGHT=0.6
BM25_WEIGHT=0.4
ENABLE_RERANKER=true
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_WEIGHT=0.7
ENABLE_QUERY_REWRITE=true
CONTEXT_MAX_TOKENS=6000
DATABASE_URL=sqlite:///./docmind.db
APP_NAME=Docmind API
APP_VERSION=0.2.0
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MEDIAWIKI_API_URL=https://oxygennotincluded.wiki.gg/zh/api.php
MEDIAWIKI_BASE_URL=https://oxygennotincluded.wiki.gg/zh
MEDIAWIKI_LANGUAGE=zh
MEDIAWIKI_ROOT_CATEGORIES=建筑,小动物
MEDIAWIKI_EXCLUDED_CATEGORY_KEYWORDS=调试,未实装,未使用,已移除,开发者,Debug,Unused,Unimplemented
MEDIAWIKI_SNAPSHOT_PATH=./data/raw/wiki
MEDIAWIKI_REQUEST_TIMEOUT=30
